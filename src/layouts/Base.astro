---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const site = 'Hiru404';
const desc0 = 'Repositori eksperimen seputar kustomisasi Blogger: tema streaming anime & manga, tutorial modifikasi, dan forum diskusi terbuka.';
const { title, description = desc0 } = Astro.props;
const fullTitle = title ? `${title} | ${site}` : `${site} | Eksperimen Kustomisasi Blogger`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const links = [
  { href: '/', label: 'Beranda' },
  { href: '/blog/', label: 'Blog' },
  { href: '/kategori/tema/', label: 'Tema' },
  { href: '/kategori/tutorial/', label: 'Tutorial' },
  { href: '/forum/', label: 'Forum' },
];
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h)) ? 'page' : undefined;
---
<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b1b3a" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site} href="/rss.xml" />
    <meta property="og:site_name" content={site} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light') document.documentElement.classList.remove('dark');
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell">
        <a href="/" class="brand">Hiru<span>404</span></a>
        <nav class="nav-desktop" aria-label="Jelajah">
          {links.map((l) => <a href={l.href} aria-current={active(l.href)}>{l.label}</a>)}
        </nav>
        <span class="spacer"></span>
        <button id="theme" class="icon-btn" type="button" aria-label="Ganti mode terang/gelap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>
        </button>
      </div>
    </header>

    <main class="shell"><slot /></main>

    <footer class="site-footer">
      <div class="shell">
        <span>Hiru404 {new Date().getFullYear()}. Proyek pengisi waktu luang.</span>
        <nav aria-label="Footer">
          <a href="/blog/">Blog</a>
          <a href="/forum/">Forum</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>

    <nav class="nav-bottom" aria-label="Navigasi utama">
      <a href="/" aria-current={active('/')}>Beranda</a>
      <a href="/blog/" aria-current={active('/blog/')}>Blog</a>
      <a href="/kategori/tema/" aria-current={active('/kategori/tema/')}>Tema</a>
      <a href="/forum/" aria-current={active('/forum/')}>Forum</a>
    </nav>

    <script is:inline>
      document.getElementById('theme').addEventListener('click', function () {
        var d = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch (e) {}
      });
    </script>
  </body>
</html>
