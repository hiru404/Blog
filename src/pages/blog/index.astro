---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog" description="Semua tema, tutorial, dan catatan eksperimen Blogger di Hiru404.">
  <h1 class="section-title" style="font-size:1.6rem">Blog</h1>
  <div class="tabs">
    <a href="/blog/" aria-current="page">Semua</a>
    <a href="/kategori/tema/">Tema</a>
    <a href="/kategori/tutorial/">Tutorial</a>
    <a href="/kategori/forum/">Forum</a>
  </div>
  <input id="q" class="search" type="search" placeholder="Cari artikel: tema, slider, dark mode..." aria-label="Cari artikel" />
  <div class="grid-posts" id="list">{posts.map((p) => <PostCard post={p} />)}</div>
  <p id="empty" hidden>Tidak ada artikel yang cocok. Coba kata kunci lain.</p>
  <script is:inline>
    var q = document.getElementById('q'), cards = document.querySelectorAll('#list .card'), empty = document.getElementById('empty');
    q.addEventListener('input', function () {
      var v = q.value.trim().toLowerCase(), n = 0;
      cards.forEach(function (c) { var ok = c.dataset.text.indexOf(v) !== -1; c.hidden = !ok; if (ok) n++; });
      empty.hidden = n !== 0;
    });
  </script>
</Base>
