---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, kategori, tags } = post.data;
---
<Base title={title} description={description}>
  <article class="prose">
    <div class="meta">
      <a class={`chip ${kategori}`} href={`/kategori/${kategori}/`}>{kategori}</a>
      <time datetime={date.toISOString()}>{date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
    </div>
    <h1>{title}</h1>
    <Content />
    {tags.length > 0 && <p class="meta">{tags.map((t) => <span class="chip">{t}</span>)}</p>}
  </article>
</Base>
